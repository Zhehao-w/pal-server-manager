<Window
    x:Class="HaoHaoTianTian.PalHR.Windows.SaveSelectorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="浩浩添添 Pal 人力资源部">

  <Grid x:Name="RootGrid" Background="{StaticResource PalBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Background="#B818242C" Padding="14,0,148,0">
      <Grid x:Name="TitleBarDragRegion">
        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
          <Run Text="浩浩添添 Pal 人力资源部" FontSize="16" FontWeight="SemiBold" />
          <Run Text="  ·  " FontSize="12" Foreground="{StaticResource PalMutedTextBrush}" />
          <Run x:Name="VersionRun" FontSize="12" Foreground="{StaticResource PalCyanBrush}" />
        </TextBlock>
      </Grid>
    </Grid>

    <Grid Grid.Row="1" Padding="22,16,22,20" RowSpacing="12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Spacing="4">
        <TextBlock Text="选择存档并启动服务器" FontSize="25" FontWeight="SemiBold" />
        <TextBlock Text="选择已有存档，或创建一个带管理标签的新世界。标签不会修改 ServerName、世界名称或存档 UID。" Foreground="{StaticResource PalMutedTextBrush}" FontSize="12" />
      </StackPanel>

      <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="43" /><RowDefinition Height="35" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Grid Padding="14,0"><TextBlock Text="存档列表" FontWeight="SemiBold" VerticalAlignment="Center" /><StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="双击也可直接启动" VerticalAlignment="Center" Foreground="{StaticResource PalMutedTextBrush}" FontSize="11" /><Button Content="重新扫描" Click="Rescan_Click" /><Button Content="导入存档…" Click="ImportSave_Click" /></StackPanel></Grid>
          <Grid Grid.Row="1" Background="#C62A3D46" Padding="12,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="45" /><ColumnDefinition Width="140" /><ColumnDefinition Width="58" /><ColumnDefinition Width="290" /><ColumnDefinition Width="76" /><ColumnDefinition Width="58" /><ColumnDefinition Width="128" /></Grid.ColumnDefinitions>
            <TextBlock Text="编号" Style="{StaticResource TableHeaderTextStyle}" /><TextBlock Grid.Column="1" Text="标签" Style="{StaticResource TableHeaderTextStyle}" /><TextBlock Grid.Column="2" Text="状态" Style="{StaticResource TableHeaderTextStyle}" /><TextBlock Grid.Column="3" Text="存档 UID · LocalData 文件夹" Style="{StaticResource TableHeaderTextStyle}" /><TextBlock Grid.Column="4" Text="大小" Style="{StaticResource TableHeaderTextStyle}" /><TextBlock Grid.Column="5" Text="玩家" Style="{StaticResource TableHeaderTextStyle}" /><TextBlock Grid.Column="6" Text="最后保存" Style="{StaticResource TableHeaderTextStyle}" />
          </Grid>
          <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.Saves}" SelectedItem="{x:Bind ViewModel.SelectedSave, Mode=TwoWay}" SelectionMode="Single" DoubleTapped="SaveList_DoubleTapped">
            <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
              <DataTemplate>
                <Grid Height="39" Padding="12,0" ColumnSpacing="10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="45" /><ColumnDefinition Width="140" /><ColumnDefinition Width="58" /><ColumnDefinition Width="290" /><ColumnDefinition Width="76" /><ColumnDefinition Width="58" /><ColumnDefinition Width="128" /></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Id}" Style="{StaticResource TableCellTextStyle}" /><TextBlock Grid.Column="1" Text="{Binding Tag}" Style="{StaticResource TableCellTextStyle}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="2" Text="{Binding State}" Style="{StaticResource TableCellTextStyle}" /><TextBlock Grid.Column="3" Text="{Binding WorldUid}" Style="{StaticResource TableCellTextStyle}" TextTrimming="CharacterEllipsis" FontFamily="Cascadia Mono, Consolas" FontSize="11" /><TextBlock Grid.Column="4" Text="{Binding Size}" Style="{StaticResource TableCellTextStyle}" /><TextBlock Grid.Column="5" Text="{Binding Players}" Style="{StaticResource TableCellTextStyle}" /><TextBlock Grid.Column="6" Text="{Binding Updated}" Style="{StaticResource TableCellTextStyle}" FontSize="11" />
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </Grid>
      </Border>

      <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="14,10">
        <Grid ColumnSpacing="10">
          <Grid.ColumnDefinitions><ColumnDefinition Width="155" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center"><TextBlock Text="修改所选标签" FontWeight="SemiBold" /><TextBlock Text="{x:Bind ViewModel.SelectedSaveText, Mode=OneWay}" Foreground="{StaticResource PalCyanBrush}" FontSize="11" /></StackPanel>
          <TextBox Grid.Column="1" Text="{x:Bind ViewModel.EditTag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="输入新标签；切换选择后会清空" MaxLength="40" />
          <Button Grid.Column="2" Content="世界设置…" Command="{x:Bind ViewModel.EditSelectedWorldSettingsCommand}" />
          <Button Grid.Column="3" Content="保存标签" Command="{x:Bind ViewModel.RenameTagCommand}" />
          <Button Grid.Column="4" Content="删除存档…" Command="{x:Bind ViewModel.DeleteWorldCommand}" Style="{StaticResource DangerButtonStyle}" />
        </Grid>
      </Border>

      <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="14,10">
        <Grid ColumnSpacing="10" RowSpacing="8">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Grid.ColumnDefinitions><ColumnDefinition Width="155" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center"><TextBlock Text="创建新存档" FontWeight="SemiBold" /><TextBlock Text="输入管理标签" Foreground="{StaticResource PalMutedTextBrush}" FontSize="11" /></StackPanel>
          <TextBox Grid.Column="1" Grid.ColumnSpan="2" Text="{x:Bind ViewModel.NewTag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="例如：周末加班档" MaxLength="40" />
          <Button Grid.Column="3" Content="创建并启动" Command="{x:Bind ViewModel.CreateCommand}" />
          <TextBlock Grid.Row="1" Text="世界设置来源" Foreground="{StaticResource PalMutedTextBrush}" VerticalAlignment="Center" />
          <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{x:Bind ViewModel.WorldSettingsSources}" SelectedItem="{x:Bind ViewModel.SelectedWorldSettingsSource, Mode=TwoWay}" DisplayMemberPath="Label" HorizontalAlignment="Stretch" />
          <TextBlock Grid.Row="1" Grid.Column="2" Text="{x:Bind ViewModel.SelectedWorldSettingsSource.Description, Mode=OneWay}" Foreground="{StaticResource PalMutedTextBrush}" FontSize="11" VerticalAlignment="Center" />
          <Button Grid.Row="1" Grid.Column="3" Content="编辑自定义…" Command="{x:Bind ViewModel.EditNewWorldSettingsCommand}" />
        </Grid>
      </Border>

      <Grid Grid.Row="4" ColumnSpacing="10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Button Content="从备份回档并启动…" Command="{x:Bind ViewModel.RollbackCommand}" />
          <TextBlock Text="{x:Bind ViewModel.Feedback, Mode=OneWay}" Foreground="{StaticResource PalMintBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="300" />
        </StackPanel>
        <Button Grid.Column="1" Content="取消" Command="{x:Bind ViewModel.CancelCommand}" />
        <Button Grid.Column="2" Content="启动所选存档" Command="{x:Bind ViewModel.StartSelectedCommand}" Style="{StaticResource PrimaryPalButtonStyle}" />
      </Grid>
    </Grid>
  </Grid>
</Window>
