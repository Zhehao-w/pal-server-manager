<Window
    x:Class="HaoHaoTianTian.PalHR.Windows.SaveSelectorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="PalServerManager">

  <Grid x:Name="RootGrid" Background="{StaticResource PalWindowTintBrush}" Loaded="RootGrid_Loaded">
    <Grid.RowDefinitions>
      <RowDefinition Height="54" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Background="#521C1C1E" Padding="18,0,148,0">
      <Grid x:Name="TitleBarDragRegion">
        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
          <Image Source="Assets/ManagerIconCircular.png" Width="24" Height="24" />
          <TextBlock Text="PalServerManager" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
          <TextBlock Text="·" Foreground="{StaticResource PalMutedTextBrush}" FontSize="11" VerticalAlignment="Center" />
          <TextBlock VerticalAlignment="Center" Foreground="{StaticResource PalMutedTextBrush}" FontSize="11"><Run x:Name="VersionRun" /></TextBlock>
        </StackPanel>
      </Grid>
    </Grid>

    <Grid x:Name="ContentGrid" Grid.Row="1" Padding="20,14,20,18" RowSpacing="10">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Spacing="3" Margin="2,0,2,2">
        <TextBlock Text="选择存档" FontSize="23" FontWeight="SemiBold" />
        <TextBlock Text="启动已有世界，或创建一个新的管理存档。管理标签不会修改游戏内世界名称。" Foreground="{StaticResource PalMutedTextBrush}" FontSize="11" />
      </StackPanel>

      <Border x:Name="MigrationNotice" Grid.Row="1" Style="{StaticResource GroupedSurfaceStyle}" Padding="14,10" Visibility="Collapsed">
        <Grid ColumnSpacing="10">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="发现未管理的现有存档" FontWeight="SemiBold" FontSize="12" />
            <TextBlock x:Name="MigrationNoticeText" Foreground="{StaticResource PalMutedTextBrush}" FontSize="11" />
          </StackPanel>
          <Button Grid.Column="1" Content="导入…" Click="ImportDiscovered_Click" Style="{StaticResource PrimaryPalButtonStyle}" />
          <Button Grid.Column="2" Content="稍后" Click="DismissMigrationNotice_Click" Style="{StaticResource CompactPalButtonStyle}" />
        </Grid>
      </Border>

      <Grid Grid.Row="2" RowSpacing="6">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid Margin="8,0">
          <TextBlock Text="存档" Style="{StaticResource SectionHeadingStyle}" VerticalAlignment="Center" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <TextBlock Text="双击直接启动" Foreground="{StaticResource PalMutedTextBrush}" FontSize="10" VerticalAlignment="Center" />
            <Button Content="重新扫描" Click="Rescan_Click" Style="{StaticResource CompactPalButtonStyle}" />
            <Button Content="导入存档…" Click="ImportSave_Click" Style="{StaticResource CompactPalButtonStyle}" />
          </StackPanel>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource GroupedSurfaceStyle}" Padding="0">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="32" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid Background="#562C2C2E" Padding="12,0" ColumnSpacing="10">
              <Grid.ColumnDefinitions><ColumnDefinition Width="45" /><ColumnDefinition Width="1.1*" MinWidth="110" /><ColumnDefinition Width="58" /><ColumnDefinition Width="2.1*" MinWidth="180" /><ColumnDefinition Width="76" /><ColumnDefinition Width="58" /><ColumnDefinition Width="1.1*" MinWidth="116" /></Grid.ColumnDefinitions>
              <TextBlock Text="编号" Style="{StaticResource TableHeaderTextStyle}" /><TextBlock Grid.Column="1" Text="标签" Style="{StaticResource TableHeaderTextStyle}" /><TextBlock Grid.Column="2" Text="状态" Style="{StaticResource TableHeaderTextStyle}" /><TextBlock Grid.Column="3" Text="存档 UID · LocalData" Style="{StaticResource TableHeaderTextStyle}" /><TextBlock Grid.Column="4" Text="大小" Style="{StaticResource TableHeaderTextStyle}" /><TextBlock Grid.Column="5" Text="玩家" Style="{StaticResource TableHeaderTextStyle}" /><TextBlock Grid.Column="6" Text="最后保存" Style="{StaticResource TableHeaderTextStyle}" />
            </Grid>
            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Saves}" SelectedItem="{x:Bind ViewModel.SelectedSave, Mode=TwoWay}" SelectionMode="Single" DoubleTapped="SaveList_DoubleTapped" ItemContainerStyle="{StaticResource SelectableSaveItemStyle}">
              <ListView.Resources>
                <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#0FFFFFFF" />
                <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#18101012" />
                <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#300A84FF" />
                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#420A84FF" />
                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#260A84FF" />
              </ListView.Resources>
              <ListView.ItemTemplate>
                <DataTemplate>
                  <Grid Height="40" Padding="12,0" ColumnSpacing="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="45" /><ColumnDefinition Width="1.1*" MinWidth="110" /><ColumnDefinition Width="58" /><ColumnDefinition Width="2.1*" MinWidth="180" /><ColumnDefinition Width="76" /><ColumnDefinition Width="58" /><ColumnDefinition Width="1.1*" MinWidth="116" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Id}" Style="{StaticResource TableCellTextStyle}" /><TextBlock Grid.Column="1" Text="{Binding Tag}" Style="{StaticResource TableCellTextStyle}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="2" Text="{Binding State}" Style="{StaticResource TableCellTextStyle}" /><TextBlock Grid.Column="3" Text="{Binding WorldUid}" Style="{StaticResource TableCellTextStyle}" TextTrimming="CharacterEllipsis" FontFamily="Cascadia Mono, Consolas" FontSize="11" /><TextBlock Grid.Column="4" Text="{Binding Size}" Style="{StaticResource TableCellTextStyle}" /><TextBlock Grid.Column="5" Text="{Binding Players}" Style="{StaticResource TableCellTextStyle}" /><TextBlock Grid.Column="6" Text="{Binding Updated}" Style="{StaticResource TableCellTextStyle}" FontSize="11" />
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
          </Grid>
        </Border>
      </Grid>

      <Grid Grid.Row="3" RowSpacing="6">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock Text="所选存档" Style="{StaticResource SectionHeadingStyle}" Margin="8,0" />
        <Border Grid.Row="1" Style="{StaticResource GroupedSurfaceStyle}" Padding="14,10">
          <Grid ColumnSpacing="9">
            <Grid.ColumnDefinitions><ColumnDefinition Width="145" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="1"><TextBlock Text="管理标签" FontWeight="SemiBold" FontSize="12" /><TextBlock Text="{x:Bind ViewModel.SelectedSaveText, Mode=OneWay}" Foreground="{StaticResource PalMutedTextBrush}" FontSize="10" /></StackPanel>
            <TextBox Grid.Column="1" Text="{x:Bind ViewModel.EditTag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="输入新标签；切换选择后会清空" MaxLength="40" />
            <Button Grid.Column="2" Content="世界设置…" Command="{x:Bind ViewModel.EditSelectedWorldSettingsCommand}" Style="{StaticResource CompactPalButtonStyle}" />
            <Button Grid.Column="3" Content="保存标签" Command="{x:Bind ViewModel.RenameTagCommand}" Style="{StaticResource CompactPalButtonStyle}" />
            <Button Grid.Column="4" Content="删除…" Command="{x:Bind ViewModel.DeleteWorldCommand}" Style="{StaticResource DangerButtonStyle}">
              <Button.Resources>
                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#30FF453A" />
                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#18FF453A" />
                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#58FF453A" />
                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#40FF453A" />
                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFAAA4" />
                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FF8179" />
              </Button.Resources>
            </Button>
          </Grid>
        </Border>
      </Grid>

      <Grid Grid.Row="4" RowSpacing="6">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock Text="创建新存档" Style="{StaticResource SectionHeadingStyle}" Margin="8,0" />
        <Border Grid.Row="1" Style="{StaticResource GroupedSurfaceStyle}" Padding="14,10">
          <Grid ColumnSpacing="9" RowSpacing="8">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="145" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="1"><TextBlock Text="管理标签" FontWeight="SemiBold" FontSize="12" /><TextBlock Text="只用于管理器识别" Foreground="{StaticResource PalMutedTextBrush}" FontSize="10" /></StackPanel>
            <TextBox Grid.Column="1" Grid.ColumnSpan="2" Text="{x:Bind ViewModel.NewTag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="例如：周末加班档" MaxLength="40" />
            <Button Grid.Column="3" Content="创建并启动" Command="{x:Bind ViewModel.CreateCommand}" Style="{StaticResource CompactPalButtonStyle}" />
            <TextBlock Grid.Row="1" Text="世界设置" Foreground="{StaticResource PalMutedTextBrush}" VerticalAlignment="Center" FontSize="11" />
            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{x:Bind ViewModel.WorldSettingsSources}" SelectedItem="{x:Bind ViewModel.SelectedWorldSettingsSource, Mode=TwoWay}" DisplayMemberPath="Label" HorizontalAlignment="Stretch" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{x:Bind ViewModel.SelectedWorldSettingsSource.Description, Mode=OneWay}" Foreground="{StaticResource PalMutedTextBrush}" FontSize="10" VerticalAlignment="Center" />
            <Button Grid.Row="1" Grid.Column="3" Content="编辑自定义…" Command="{x:Bind ViewModel.EditNewWorldSettingsCommand}" Style="{StaticResource CompactPalButtonStyle}" />
          </Grid>
        </Border>
      </Grid>

      <Grid Grid.Row="5" ColumnSpacing="10" Margin="2,2,2,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Button Content="从备份回档并启动…" Command="{x:Bind ViewModel.RollbackCommand}" Style="{StaticResource CompactPalButtonStyle}" />
          <TextBlock Text="{x:Bind ViewModel.Feedback, Mode=OneWay}" Foreground="{StaticResource PalMutedTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="320" FontSize="11" />
        </StackPanel>
        <Button Grid.Column="1" Content="取消" Command="{x:Bind ViewModel.CancelCommand}" Style="{StaticResource CompactPalButtonStyle}" />
        <Button Grid.Column="2" Content="启动所选存档" Command="{x:Bind ViewModel.StartSelectedCommand}" Style="{StaticResource PrimaryPalButtonStyle}" />
      </Grid>
    </Grid>
  </Grid>
</Window>
