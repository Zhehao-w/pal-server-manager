<Application
    x:Class="HaoHaoTianTian.PalHR.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>

      <Color x:Key="PalBackgroundColor">#1C1C1E</Color>
      <Color x:Key="PalCardColor">#D52C2C2E</Color>
      <Color x:Key="PalCardAltColor">#B5242426</Color>
      <Color x:Key="PalBorderColor">#24FFFFFF</Color>
      <Color x:Key="PalCyanColor">#0A84FF</Color>
      <Color x:Key="PalMintColor">#30D158</Color>
      <Color x:Key="PalTextColor">#F5F5F7</Color>
      <Color x:Key="PalMutedTextColor">#A1A1A6</Color>
      <Color x:Key="PalWarmColor">#FF9F0A</Color>
      <Color x:Key="PalDangerColor">#FF453A</Color>

      <SolidColorBrush x:Key="PalBackgroundBrush" Color="{StaticResource PalBackgroundColor}" />
      <SolidColorBrush x:Key="PalCardBrush" Color="{StaticResource PalCardColor}" />
      <SolidColorBrush x:Key="PalCardAltBrush" Color="{StaticResource PalCardAltColor}" />
      <SolidColorBrush x:Key="PalBorderBrush" Color="{StaticResource PalBorderColor}" />
      <SolidColorBrush x:Key="PalCyanBrush" Color="{StaticResource PalCyanColor}" />
      <SolidColorBrush x:Key="PalMintBrush" Color="{StaticResource PalMintColor}" />
      <SolidColorBrush x:Key="PalTextBrush" Color="{StaticResource PalTextColor}" />
      <SolidColorBrush x:Key="PalMutedTextBrush" Color="{StaticResource PalMutedTextColor}" />
      <SolidColorBrush x:Key="PalWarmBrush" Color="{StaticResource PalWarmColor}" />
      <SolidColorBrush x:Key="PalDangerBrush" Color="{StaticResource PalDangerColor}" />
      <SolidColorBrush x:Key="PalWindowTintBrush" Color="#651C1C1E" />
      <SolidColorBrush x:Key="PalInsetBrush" Color="#A61B1B1D" />
      <SolidColorBrush x:Key="PalHairlineBrush" Color="#18FFFFFF" />

      <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI Variable Text</FontFamily>
      <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
      <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#8E2A2A2D" />
      <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#A9333336" />
      <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#BE202023" />
      <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#30FFFFFF" />
      <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#1AFFFFFF" />

      <SolidColorBrush x:Key="AccentButtonBackground" Color="{StaticResource PalCyanColor}" />
      <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#2997FF" />
      <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#0071E3" />
      <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#520A84FF" />
      <SolidColorBrush x:Key="AccentButtonForeground" Color="White" />
      <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="White" />
      <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="White" />
      <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#80FFFFFF" />
      <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#00000000" />
      <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="#00000000" />
      <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="#00000000" />
      <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="#00000000" />

      <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PalCardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PalBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16" />
      </Style>

      <Style x:Key="GroupedSurfaceStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PalCardAltBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PalBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
      </Style>

      <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource PalMutedTextBrush}" />
        <Setter Property="FontSize" Value="11" />
      </Style>

      <Style x:Key="MetricValueStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource PalTextBrush}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>

      <Style x:Key="TableHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource PalMutedTextBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>

      <Style x:Key="TableCellTextStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>

      <Style x:Key="SectionHeadingStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource PalMutedTextBrush}" />
      </Style>

      <Style x:Key="InsetPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PalInsetBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PalBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14" />
      </Style>

      <Style x:Key="IconPalButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Width" Value="32" /><Setter Property="Height" Value="30" />
        <Setter Property="MinWidth" Value="0" /><Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="8" /><Setter Property="UseSystemFocusVisuals" Value="True" />
      </Style>

      <Style x:Key="CompactPalButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
      </Style>

      <Style x:Key="ReadOnlyRosterItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Background" Value="Transparent" />
      </Style>

      <Style x:Key="SelectableSaveItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="Margin" Value="6,2" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
      </Style>

      <Style x:Key="ColoredPalButtonBaseStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderThickness" Value="1" />
      </Style>

      <Style x:Key="PrimaryPalButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>

      <Style x:Key="MaintenanceButtonStyle" TargetType="Button" BasedOn="{StaticResource ColoredPalButtonBaseStyle}">
        <Setter Property="Background" Value="#20FF9F0A" />
        <Setter Property="Foreground" Value="#FFD08A" />
        <Setter Property="BorderBrush" Value="#38FF9F0A" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>

      <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ColoredPalButtonBaseStyle}">
        <Setter Property="Background" Value="#20FF453A" />
        <Setter Property="Foreground" Value="#FF8A82" />
        <Setter Property="BorderBrush" Value="#40FF453A" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
