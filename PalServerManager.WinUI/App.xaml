<Application
    x:Class="HaoHaoTianTian.PalHR.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>

      <Color x:Key="PalBackgroundColor">#17191C</Color>
      <Color x:Key="PalCardColor">#D926292E</Color>
      <Color x:Key="PalCardAltColor">#B91E2125</Color>
      <Color x:Key="PalBorderColor">#4AFFFFFF</Color>
      <Color x:Key="PalCyanColor">#68B9F2</Color>
      <Color x:Key="PalMintColor">#69CFA0</Color>
      <Color x:Key="PalTextColor">#F4F5F6</Color>
      <Color x:Key="PalMutedTextColor">#AAB0B7</Color>
      <Color x:Key="PalWarmColor">#E4B56A</Color>
      <Color x:Key="PalDangerColor">#E58383</Color>

      <SolidColorBrush x:Key="PalBackgroundBrush" Color="{StaticResource PalBackgroundColor}" />
      <SolidColorBrush x:Key="PalCardBrush" Color="{StaticResource PalCardColor}" />
      <SolidColorBrush x:Key="PalCardAltBrush" Color="{StaticResource PalCardAltColor}" />
      <SolidColorBrush x:Key="PalBorderBrush" Color="{StaticResource PalBorderColor}" />
      <SolidColorBrush x:Key="PalCyanBrush" Color="{StaticResource PalCyanColor}" />
      <SolidColorBrush x:Key="PalMintBrush" Color="{StaticResource PalMintColor}" />
      <SolidColorBrush x:Key="PalTextBrush" Color="{StaticResource PalTextColor}" />
      <SolidColorBrush x:Key="PalMutedTextBrush" Color="{StaticResource PalMutedTextColor}" />
      <SolidColorBrush x:Key="PalWarmBrush" Color="{StaticResource PalWarmColor}" />
      <SolidColorBrush x:Key="PalDangerBrush" Color="{StaticResource PalDangerColor}" />
      <SolidColorBrush x:Key="PalWindowTintBrush" Color="#7117191C" />
      <SolidColorBrush x:Key="PalInsetBrush" Color="#7A111316" />

      <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI Variable Text</FontFamily>
      <CornerRadius x:Key="ControlCornerRadius">9</CornerRadius>
      <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#941F2226" />
      <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#B52A2E33" />
      <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#CC181A1E" />
      <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#52FFFFFF" />
      <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#32FFFFFF" />

      <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PalCardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PalBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="16" />
      </Style>

      <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource PalMutedTextBrush}" />
        <Setter Property="FontSize" Value="12" />
      </Style>

      <Style x:Key="MetricValueStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource PalTextBrush}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>

      <Style x:Key="TableHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource PalMutedTextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>

      <Style x:Key="TableCellTextStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>

      <Style x:Key="SectionHeadingStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource PalTextBrush}" />
      </Style>

      <Style x:Key="InsetPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PalInsetBrush}" />
        <Setter Property="BorderBrush" Value="#35FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12" />
      </Style>

      <Style x:Key="IconPalButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Width" Value="34" /><Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="0" /><Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="9" /><Setter Property="UseSystemFocusVisuals" Value="True" />
      </Style>

      <Style x:Key="ReadOnlyRosterItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
        <Style.Resources>
          <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
          <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
          <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
        </Style.Resources>
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Background" Value="Transparent" />
      </Style>

      <Style x:Key="SelectableSaveItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
        <Style.Resources>
          <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#182FFFFF" />
          <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#26101214" />
          <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#354D9BCF" />
          <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#465DAFE3" />
          <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#3C3E85B6" />
        </Style.Resources>
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="Margin" Value="6,2" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
      </Style>

      <Style TargetType="ContentDialog" BasedOn="{StaticResource DefaultContentDialogStyle}">
        <Setter Property="CornerRadius" Value="16" />
      </Style>
      <Style TargetType="Expander" BasedOn="{StaticResource DefaultExpanderStyle}">
        <Setter Property="Background" Value="{StaticResource PalCardAltBrush}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Margin" Value="0,0,0,8" />
      </Style>

      <Style x:Key="ColoredPalButtonBaseStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="BorderThickness" Value="1" />
      </Style>

      <Style x:Key="PrimaryPalButtonStyle" TargetType="Button" BasedOn="{StaticResource ColoredPalButtonBaseStyle}">
        <Setter Property="Background" Value="{StaticResource PalCyanBrush}" />
        <Setter Property="Foreground" Value="#10242A" />
        <Setter Property="BorderBrush" Value="#70DCE7" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>

      <Style x:Key="MaintenanceButtonStyle" TargetType="Button" BasedOn="{StaticResource ColoredPalButtonBaseStyle}">
        <Setter Property="Background" Value="#403A32" />
        <Setter Property="Foreground" Value="#F3CF9C" />
        <Setter Property="BorderBrush" Value="#6D604E" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>

      <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ColoredPalButtonBaseStyle}">
        <Setter Property="Background" Value="#3D2D32" />
        <Setter Property="Foreground" Value="#FFB4AB" />
        <Setter Property="BorderBrush" Value="#76505A" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
