<Window
    x:Class="HaoHaoTianTian.PalHR.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="PalServerManager">

  <Grid x:Name="RootGrid" Background="{StaticResource PalWindowTintBrush}" Loaded="RootGrid_Loaded">
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid x:Name="AppTitleBar" Grid.Row="0" Background="{StaticResource PalTitleBarBrush}" Padding="18,0,0,0" ColumnSpacing="8" Loaded="AppTitleBar_Loaded" SizeChanged="AppTitleBar_SizeChanged">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition x:Name="TitleBarRightInsetColumn" Width="0" />
      </Grid.ColumnDefinitions>
      <Grid x:Name="TitleBarDragRegion" Grid.Column="0" VerticalAlignment="Stretch" ColumnSpacing="10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Image Source="Assets/ManagerIconCircular.png" Width="24" Height="24" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="PalServerManager" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
          <TextBlock Text="·" Foreground="{StaticResource PalMutedTextBrush}" FontSize="11" VerticalAlignment="Center" />
          <TextBlock x:Name="VersionRunHost" FontSize="11" Foreground="{StaticResource PalMutedTextBrush}" VerticalAlignment="Center"><Run x:Name="VersionRun" /></TextBlock>
        </StackPanel>
      </Grid>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,8,0">
        <TextBlock Text="{x:Bind ViewModel.UpdatedAt, Mode=OneWay}" Foreground="{StaticResource PalMutedTextBrush}" FontSize="11" VerticalAlignment="Center" />
        <Button Command="{x:Bind ViewModel.RefreshCommand}" Style="{StaticResource IconPalButtonStyle}" ToolTipService.ToolTip="立即刷新服务器状态" AutomationProperties.Name="立即刷新服务器状态">
          <FontIcon Glyph="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="14" />
        </Button>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" Padding="18,14,18,16" RowSpacing="10">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="64" /><RowDefinition Height="*" /><RowDefinition Height="186" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

      <Border Grid.Row="0" Style="{StaticResource GroupedSurfaceStyle}" Padding="16,14">
        <Grid RowSpacing="11">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="32" /></Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.6*" /><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="0.8*" /><ColumnDefinition Width="0.8*" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="2" Margin="0,0,16,0">
              <TextBlock Text="{x:Bind ViewModel.ServerIdentity, Mode=OneWay}" Style="{StaticResource MetricLabelStyle}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{x:Bind ViewModel.ServerState, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="{x:Bind ViewModel.PowerState, Mode=OneWay}" Foreground="{StaticResource PalMutedTextBrush}" FontSize="11" />
            </StackPanel>
            <Border Grid.Column="1" BorderBrush="{StaticResource PalHairlineBrush}" BorderThickness="1,0,0,0" Padding="18,0,8,0">
              <StackPanel Spacing="2"><TextBlock Text="当前存档" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{x:Bind ViewModel.ActiveSave, Mode=OneWay}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /></StackPanel>
            </Border>
            <Border Grid.Column="2" BorderBrush="{StaticResource PalHairlineBrush}" BorderThickness="1,0,0,0" Padding="18,0,8,0">
              <StackPanel Spacing="2"><TextBlock Text="在线玩家" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{x:Bind ViewModel.PlayerCount, Mode=OneWay}" FontSize="17" FontWeight="SemiBold" /></StackPanel>
            </Border>
            <Border Grid.Column="3" BorderBrush="{StaticResource PalHairlineBrush}" BorderThickness="1,0,0,0" Padding="18,0,0,0">
              <StackPanel Spacing="2"><TextBlock Text="REST API" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{x:Bind ViewModel.RestState, Mode=OneWay}" FontSize="17" FontWeight="SemiBold" /></StackPanel>
            </Border>
          </Grid>
          <Border Grid.Row="1" Background="{StaticResource PalInsetBrush}" CornerRadius="8" Padding="10,0">
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="存档 UID" Foreground="{StaticResource PalMutedTextBrush}" FontSize="11" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.WorldUid, Mode=OneWay}" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas" FontSize="11" TextTrimming="CharacterEllipsis" />
              <Button Grid.Column="2" Content="复制" Click="CopyUid_Click" Style="{StaticResource CompactPalButtonStyle}" MinHeight="26" Padding="10,2" VerticalAlignment="Center" />
            </Grid>
          </Border>
        </Grid>
      </Border>

      <Border Grid.Row="1" Style="{StaticResource GroupedSurfaceStyle}" Padding="0">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
          <StackPanel Margin="15,10"><TextBlock Text="FPS" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{x:Bind ViewModel.Fps, Mode=OneWay}" Style="{StaticResource MetricValueStyle}" /></StackPanel>
          <Border Grid.Column="1" BorderBrush="{StaticResource PalHairlineBrush}" BorderThickness="1,0,0,0"><StackPanel Margin="15,10"><TextBlock Text="帧时间" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{x:Bind ViewModel.FrameTime, Mode=OneWay}" Style="{StaticResource MetricValueStyle}" /></StackPanel></Border>
          <Border Grid.Column="2" BorderBrush="{StaticResource PalHairlineBrush}" BorderThickness="1,0,0,0"><StackPanel Margin="15,10"><TextBlock Text="CPU" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{x:Bind ViewModel.Cpu, Mode=OneWay}" Style="{StaticResource MetricValueStyle}" /></StackPanel></Border>
          <Border Grid.Column="3" BorderBrush="{StaticResource PalHairlineBrush}" BorderThickness="1,0,0,0"><StackPanel Margin="15,10"><TextBlock Text="内存" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{x:Bind ViewModel.Memory, Mode=OneWay}" Style="{StaticResource MetricValueStyle}" /></StackPanel></Border>
          <Border Grid.Column="4" BorderBrush="{StaticResource PalHairlineBrush}" BorderThickness="1,0,0,0"><StackPanel Margin="15,10"><TextBlock Text="运行时间" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{x:Bind ViewModel.Uptime, Mode=OneWay}" Style="{StaticResource MetricValueStyle}" /></StackPanel></Border>
          <Border Grid.Column="5" BorderBrush="{StaticResource PalHairlineBrush}" BorderThickness="1,0,0,0"><StackPanel Margin="15,10"><TextBlock Text="磁盘可用" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{x:Bind ViewModel.FreeDisk, Mode=OneWay}" Style="{StaticResource MetricValueStyle}" /></StackPanel></Border>
        </Grid>
      </Border>

      <Border Grid.Row="2" Style="{StaticResource GroupedSurfaceStyle}" Padding="0">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="32" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Grid Padding="14,0">
            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
              <TextBlock Text="玩家" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
              <TextBlock Text="{x:Bind ViewModel.PlayerRosterSummary, Mode=OneWay}" Foreground="{StaticResource PalMutedTextBrush}" FontSize="11" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="在线状态每 10 秒刷新" Foreground="{StaticResource PalMutedTextBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
          </Grid>
          <Grid Grid.Row="1" Background="{StaticResource PalTableHeaderBrush}" Padding="14,0,28,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="58" /><ColumnDefinition Width="1.1*" MinWidth="100" /><ColumnDefinition Width="48" /><ColumnDefinition Width="68" /><ColumnDefinition Width="90" /><ColumnDefinition Width="1.1*" MinWidth="118" /><ColumnDefinition Width="*" MinWidth="110" /></Grid.ColumnDefinitions>
            <TextBlock Text="状态" Style="{StaticResource TableHeaderTextStyle}" />
            <TextBlock Grid.Column="1" Text="玩家" Style="{StaticResource TableHeaderTextStyle}" />
            <TextBlock Grid.Column="2" Text="等级" HorizontalAlignment="Center" Style="{StaticResource TableHeaderTextStyle}" />
            <TextBlock Grid.Column="3" Text="延迟" HorizontalAlignment="Center" Style="{StaticResource TableHeaderTextStyle}" />
            <TextBlock Grid.Column="4" Text="本次在线" HorizontalAlignment="Center" Style="{StaticResource TableHeaderTextStyle}" />
            <TextBlock Grid.Column="5" Text="上次在线" Style="{StaticResource TableHeaderTextStyle}" />
            <TextBlock Grid.Column="6" Text="平台账号" Style="{StaticResource TableHeaderTextStyle}" />
          </Grid>
          <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.Players}" SelectionMode="None" IsItemClickEnabled="False" ItemContainerStyle="{StaticResource ReadOnlyRosterItemStyle}" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.Resources>
              <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#08000000" />
              <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#10000000" />
              <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
            </ListView.Resources>
            <ListView.ItemTemplate>
              <DataTemplate>
                <Grid Height="44" Padding="14,0,28,0" ColumnSpacing="12" ToolTipService.ToolTip="{Binding PlayerId}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="58" /><ColumnDefinition Width="1.1*" MinWidth="100" /><ColumnDefinition Width="48" /><ColumnDefinition Width="68" /><ColumnDefinition Width="90" /><ColumnDefinition Width="1.1*" MinWidth="118" /><ColumnDefinition Width="*" MinWidth="110" /></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Status}" Style="{StaticResource TableCellTextStyle}" FontSize="12" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource TableCellTextStyle}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="2" Text="{Binding Level}" HorizontalAlignment="Center" Style="{StaticResource TableCellTextStyle}" />
                  <TextBlock Grid.Column="3" Text="{Binding Ping}" HorizontalAlignment="Center" Style="{StaticResource TableCellTextStyle}" />
                  <TextBlock Grid.Column="4" Text="{Binding OnlineDuration}" HorizontalAlignment="Center" Style="{StaticResource TableCellTextStyle}" />
                  <TextBlock Grid.Column="5" Text="{Binding LastOnline}" Style="{StaticResource TableCellTextStyle}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="6" Text="{Binding Account}" Style="{StaticResource TableCellTextStyle}" TextTrimming="CharacterEllipsis" />
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </Grid>
      </Border>

      <Grid Grid.Row="3" ColumnSpacing="10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="0.94*" /><ColumnDefinition Width="1.06*" /></Grid.ColumnDefinitions>
        <Border Style="{StaticResource GroupedSurfaceStyle}" Padding="14,12">
          <Grid RowSpacing="7">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="32" /><RowDefinition Height="32" /><RowDefinition Height="32" /></Grid.RowDefinitions>
            <TextBlock Text="服务器操作" Style="{StaticResource SectionHeadingStyle}" />
            <TextBlock Grid.Row="1" Text="保存、重启、关服或回档当前存档。" Foreground="{StaticResource PalMutedTextBrush}" FontSize="11" />
            <Grid Grid.Row="2" ColumnSpacing="8">
              <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
              <Button Content="立即保存" Command="{x:Bind ViewModel.SaveCommand}" IsEnabled="{x:Bind ViewModel.IsServerRunning, Mode=OneWay}" Style="{StaticResource CompactPalButtonStyle}" HorizontalAlignment="Stretch" />
              <Button Grid.Column="1" Content="保存并重启" Command="{x:Bind ViewModel.RestartCommand}" IsEnabled="{x:Bind ViewModel.IsServerRunning, Mode=OneWay}" Style="{StaticResource RestartButtonStyle}" HorizontalAlignment="Stretch">
                <Button.Resources>
                  <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#E7F0F9" />
                  <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#DDEAF6" />
                  <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#B4CCE2" />
                  <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#A5C2DB" />
                  <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#0B5C9B" />
                  <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#084A7D" />
                </Button.Resources>
              </Button>
            </Grid>
            <Grid Grid.Row="3" ColumnSpacing="8">
              <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
              <Button Content="保存并关服" Command="{x:Bind ViewModel.SaveStopCommand}" IsEnabled="{x:Bind ViewModel.IsServerRunning, Mode=OneWay}" Style="{StaticResource NormalExitButtonStyle}" HorizontalAlignment="Stretch">
                <Button.Resources>
                  <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#D2E5F8" />
                  <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#C4DCF4" />
                  <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#9FC4E8" />
                  <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#8CB7E0" />
                  <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#004F91" />
                  <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#004176" />
                </Button.Resources>
              </Button>
              <Button Grid.Column="1" Content="不保存强制关服" Command="{x:Bind ViewModel.ForceStopCommand}" IsEnabled="{x:Bind ViewModel.IsServerRunning, Mode=OneWay}" Style="{StaticResource DangerButtonStyle}" HorizontalAlignment="Stretch">
                <Button.Resources>
                  <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#18FF3B30" />
                  <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#24FF3B30" />
                  <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#38FF3B30" />
                  <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#48FF3B30" />
                  <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#C70015" />
                  <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#A50012" />
                </Button.Resources>
              </Button>
            </Grid>
            <Grid Grid.Row="4" ColumnSpacing="8">
              <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
              <Button Content="从备份回档…" Command="{x:Bind ViewModel.RollbackCommand}" Style="{StaticResource CompactPalButtonStyle}" HorizontalAlignment="Stretch" />
              <Button Grid.Column="1" Content="世界设置…" Command="{x:Bind ViewModel.EditWorldSettingsCommand}" Style="{StaticResource CompactPalButtonStyle}" HorizontalAlignment="Stretch" />
            </Grid>
          </Grid>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource GroupedSurfaceStyle}" Padding="14,12">
          <Grid RowSpacing="8">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="36" /><RowDefinition Height="34" /><RowDefinition Height="1" /><RowDefinition Height="34" /></Grid.RowDefinitions>
            <Grid><TextBlock Text="自动操作" Style="{StaticResource SectionHeadingStyle}" /><TextBlock Text="关闭管理器会取消预约" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource PalMutedTextBrush}" FontSize="10" /></Grid>
            <Grid Grid.Row="1" ColumnSpacing="7">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="52" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="52" /></Grid.ColumnDefinitions>
              <TextBlock Text="预约日期" VerticalAlignment="Center" Foreground="{StaticResource PalMutedTextBrush}" FontSize="10" />
              <CalendarDatePicker Grid.Column="1" Date="{x:Bind ViewModel.ScheduleDate, Mode=TwoWay}" DateFormat="{}{year.full}-{month.integer(2)}-{day.integer(2)}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
              <TextBlock Grid.Column="2" Text="24h" VerticalAlignment="Center" Foreground="{StaticResource PalMutedTextBrush}" FontSize="10" />
              <NumberBox Grid.Column="3" Value="{x:Bind ViewModel.ScheduleHour, Mode=TwoWay}" Minimum="0" Maximum="23" SmallChange="1" SpinButtonPlacementMode="Hidden" Padding="8,5,4,3" VerticalAlignment="Stretch" VerticalContentAlignment="Center" />
              <TextBlock Grid.Column="4" Text=":" VerticalAlignment="Center" FontWeight="SemiBold" />
              <NumberBox Grid.Column="5" Value="{x:Bind ViewModel.ScheduleMinute, Mode=TwoWay}" Minimum="0" Maximum="59" SmallChange="1" SpinButtonPlacementMode="Hidden" Padding="8,5,4,3" VerticalAlignment="Stretch" VerticalContentAlignment="Center" />
            </Grid>
            <Grid Grid.Row="2" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ToggleSwitch IsOn="{x:Bind ViewModel.SchedulePowerOff, Mode=TwoWay}" OnContent="结束后关机" OffContent="结束后关机" VerticalAlignment="Center" /><Button Grid.Column="1" Content="设置预约" Command="{x:Bind ViewModel.SetScheduleCommand}" IsEnabled="{x:Bind ViewModel.IsServerRunning, Mode=OneWay}" Style="{StaticResource PrimaryPalButtonStyle}" VerticalAlignment="Stretch" /><Button Grid.Column="2" Content="取消" Command="{x:Bind ViewModel.CancelScheduleCommand}" IsEnabled="{x:Bind ViewModel.HasSchedule, Mode=OneWay}" Style="{StaticResource CompactPalButtonStyle}" VerticalAlignment="Stretch" /></Grid>
            <Rectangle Grid.Row="3" Fill="{StaticResource PalHairlineBrush}" />
            <Grid Grid.Row="4" ColumnSpacing="8">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="86" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <ToggleSwitch IsOn="{x:Bind ViewModel.IdleShutdownEnabled, Mode=TwoWay}" OnContent="空服自动处理" OffContent="空服自动处理" VerticalAlignment="Center" />
              <Grid Grid.Column="1" ColumnSpacing="3">
                <Grid.ColumnDefinitions><ColumnDefinition Width="60" /><ColumnDefinition Width="23" /></Grid.ColumnDefinitions>
                <NumberBox Value="{x:Bind ViewModel.IdleShutdownMinutes, Mode=TwoWay}" Minimum="1" Maximum="1440" SmallChange="1" SpinButtonPlacementMode="Hidden" ValidationMode="InvalidInputOverwritten" AcceptsExpression="False" IsWrapEnabled="False" Padding="8,5,4,3" VerticalAlignment="Stretch" VerticalContentAlignment="Center" />
                <Grid Grid.Column="1" RowSpacing="2">
                  <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                  <Button MinWidth="0" MinHeight="0" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="IncreaseIdleMinutes_Click" ToolTipService.ToolTip="增加 1 分钟" AutomationProperties.Name="增加 1 分钟"><FontIcon Glyph="&#xE70E;" FontFamily="Segoe Fluent Icons" FontSize="8" /></Button>
                  <Button Grid.Row="1" MinWidth="0" MinHeight="0" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="DecreaseIdleMinutes_Click" ToolTipService.ToolTip="减少 1 分钟" AutomationProperties.Name="减少 1 分钟"><FontIcon Glyph="&#xE70D;" FontFamily="Segoe Fluent Icons" FontSize="8" /></Button>
                </Grid>
              </Grid>
              <TextBlock Grid.Column="2" Text="分钟" VerticalAlignment="Center" Foreground="{StaticResource PalMutedTextBrush}" />
              <ToggleSwitch Grid.Column="3" IsOn="{x:Bind ViewModel.IdleShutdownPowerOff, Mode=TwoWay}" OnContent="关服后关闭电脑" OffContent="关服后关闭电脑" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <InfoBar Grid.Row="4" IsOpen="True" IsClosable="False" Severity="Informational" Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Padding="10,5" />
    </Grid>
  </Grid>
</Window>